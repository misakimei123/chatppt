# ChatPPT Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# LLM Configuration (DashScope / Qwen)
# ===========================================
DASHSCOPE_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===========================================
# Web Search API (Optional - for EvidenceBuilder)
# ===========================================
SEARCH_API_KEY=your-search-api-key-here
SEARCH_API_URL=https://api.example.com/search

# ===========================================
# Application Settings
# ===========================================
LOG_LEVEL=INFO
ARTIFACT_ROOT=artifacts
TEMPLATE_ROOT=templates/default

# ===========================================
# FastAPI Settings
# ===========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ===========================================
# Cache Settings
# ===========================================
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Redis Configuration (for production caching)
REDIS_URL=redis://localhost:6379

# ===========================================
# Telemetry & Monitoring (Optional)
# ===========================================
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=https://your-telemetry-endpoint.com

# ===========================================
# Frontend Settings (Optional - for Streamlit)
# ===========================================
STREAMLIT_SERVER_PORT=8501
BACKEND_URL=http://localhost:8000
